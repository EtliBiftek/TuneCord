function detectBrowsers() {
  const found = [];
  const seen = new Set();
  for (const browser of browserCandidates()) {
    const executable = browser.paths.find(candidate => candidate && fs.existsSync(candidate));
    if (!executable) continue;
    const key = executable.toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    found.push({ id: browser.id, family: browser.family, name: browser.name, path: executable, accent: browser.accent, extensionsUrl: browser.extensionsUrl });
  }
  return found;
}

function extensionSourcePath(family) {
  const folder = family === "firefox" ? "extension-firefox" : "extension";
  const packaged = path.join(process.resourcesPath, folder);
  if (app.isPackaged && fs.existsSync(packaged)) return packaged;
  return path.join(app.getAppPath(), folder);
}

function installedExtensionPath(family = config.selectedBrowserFamily || "chromium") {
  const roaming = process.env.APPDATA || app.getPath("appData");
  return path.join(roaming, "TuneCord", family === "firefox" ? "extension-firefox" : "extension");
}

function copyExtensionFiles(family) {
  const source = extensionSourcePath(family);
  const target = installedExtensionPath(family);
  if (!fs.existsSync(source)) throw new Error("Paket içindeki TuneCord eklentisi bulunamadı.");
  fs.rmSync(target, { recursive: true, force: true });
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.cpSync(source, target, { recursive: true });
  return target;
}

function spawnBrowser(browser, url) {
  if (!browser?.path || !fs.existsSync(browser.path)) throw new Error("Seçilen tarayıcı artık bulunamıyor.");
  const args = url ? ["-new-window", url] : [];
  if (browser.family === "chromium") args[0] = "--new-window";
  const child = spawn(browser.path, args, { detached: true, stdio: "ignore", windowsHide: false });
  child.unref();
}

function prepareBrowserExtension(browserId) {
  const browser = detectBrowsers().find(item => item.id === browserId);
  if (!browser) throw new Error("Seçtiğin tarayıcı bulunamadı. Yeniden tara.");
  const extensionPath = copyExtensionFiles(browser.family);
  config.selectedBrowserId = browser.id;
  config.selectedBrowserPath = browser.path;
  config.selectedBrowserFamily = browser.family;
  config.extensionInstalled = true;
  config.setupComplete = true;
  saveConfig();
  try { spawnBrowser(browser, browser.extensionsUrl); } catch (_) {}
  return {
    browser,
    family: browser.family,
    extensionPath,
    manifestPath: path.join(extensionPath, "manifest.json"),
    extensionsUrl: browser.extensionsUrl,
    temporary: browser.family === "firefox"
  };
}

function selectedBrowserInfo() {
  const detected = detectBrowsers();
  return detected.find(item => item.id === config.selectedBrowserId) || (config.selectedBrowserPath ? {
    id: config.selectedBrowserId,
    family: config.selectedBrowserFamily || browserFamilyFromId(config.selectedBrowserId),
    name: config.selectedBrowserId || "Tarayıcı",
    path: config.selectedBrowserPath,
    accent: "#d94683",
    extensionsUrl: (config.selectedBrowserFamily === "firefox") ? "about:debugging#/runtime/this-firefox" : "chrome://extensions/"
  } : null);
}

function status() {
  const browser = selectedBrowserInfo();
  const family = browser?.family || config.selectedBrowserFamily || "chromium";
  return {
    enabled: config.enabled,
    selectedOnly: config.selectedOnly,
    discordAppId: config.discordAppId,
    defaultDiscordAppId: DEFAULT_DISCORD_APP_ID,
    playlists: config.playlists,
    selectedPlaylistIds: config.selectedPlaylistIds,
    startup: config.startup,
    setupComplete: config.setupComplete,
    selectedBrowserId: config.selectedBrowserId,
    selectedBrowser: browser,
    extensionInstalled: Boolean(config.extensionInstalled && fs.existsSync(installedExtensionPath(family))),
    extensionPath: installedExtensionPath(family),
    extensionConnected: Date.now() - extensionSeenAt < 35000,
    discordConnected,
    discordConnecting,
    discordError,
    transport: "websocket",
    track
  };
}

