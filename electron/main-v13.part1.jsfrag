    ]},
    { id: "opera-gx", family: "chromium", name: "Opera GX", accent: "#ff1b6b", extensionsUrl: "opera://extensions/", paths: [
      path.join(local, "Programs", "Opera GX", "opera.exe"), path.join(local, "Programs", "Opera GX", "launcher.exe"), path.join(roaming, "Opera Software", "Opera GX Stable", "opera.exe")
    ]},
    { id: "opera", family: "chromium", name: "Opera", accent: "#ff1b2d", extensionsUrl: "opera://extensions/", paths: [
      path.join(local, "Programs", "Opera", "opera.exe"), path.join(local, "Programs", "Opera", "launcher.exe")
    ]},
