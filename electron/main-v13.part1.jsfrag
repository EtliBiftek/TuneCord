    ]},
    { id: "chrome", family: "chromium", name: "Google Chrome", accent: "#4285f4", extensionsUrl: "chrome://extensions/", paths: [
      path.join(local, "Google", "Chrome", "Application", "chrome.exe"),
      path.join(pf, "Google", "Chrome", "Application", "chrome.exe"),
      path.join(pfx86, "Google", "Chrome", "Application", "chrome.exe")
    ]},
    { id: "edge", family: "chromium", name: "Microsoft Edge", accent: "#0aa7b5", extensionsUrl: "edge://extensions/", paths: [
