{
  "manifest_version": 3,
  "name": "TuneCord - YouTube Discord Presence",
  "description": "YouTube ve YouTube Music'te dinlediğin parçayı TuneCord üzerinden Discord'da gösterir.",
  "version": "1.4.5",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {"scripts": ["background.js"]},
  "action": {
    "default_title": "TuneCord",
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "options_ui": {"page":"options.html","open_in_tab":true},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "tunecord@etlibiftek.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
