{
  "manifest_version": 3,
  "name": "TuneCord - YouTube Discord Presence",
  "description": "YouTube ve YouTube Music'te dinlediğin parçayı Discord Rich Presence olarak gösterir.",
  "version": "1.1.1",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:37645/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TuneCord",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
